# Lost & Found Management System - Environment Variables Template
# Copy this file to .env and fill in the values

# Database
# SQLite local file (default - no external DB needed)
DATABASE_URL="file:./dev.db"

# Alternative: PostgreSQL (for production)
# DATABASE_URL="postgresql://user:password@localhost:5432/lost_and_found?schema=public"

# AI/Embedding Model Configuration (OpenRouter / NVIDIA NIM compatible)
# Get API keys from: https://openrouter.ai/ or NVIDIA NIM
AI_API_KEY=""  # Your API key for embedding/vision models
AI_BASE_URL="https://openrouter.ai/api/v1"  # Or NVIDIA NIM endpoint
AI_EMBEDDING_MODEL="text-embedding-3-small"  # Embedding model for text similarity
AI_VISION_MODEL="gpt-4-vision-preview"  # Vision model for image analysis

# Storage Configuration
# Local file storage (default)
STORAGE_TYPE="local"
STORAGE_LOCAL_PATH="./uploads"

# Alternative: AWS S3 / Cloudflare R2
# STORAGE_TYPE="s3"
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_REGION=""

# Notification Service (Email)
# SMTP configuration for email notifications
SMTP_HOST=""  # e.g., smtp.gmail.com
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@lostandfound.local"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Lost & Found"

# Development
NODE_ENV="development"